# --- required ---
TELEGRAM_BOT_TOKEN=         # from @BotFather (/newbot)
OWNER_TELEGRAM_ID=           # your numeric Telegram user id (ask @userinfobot)
ANTHROPIC_API_KEY=           # console.anthropic.com → API keys

# --- Google (files, not secrets in this file) ---
# Put the OAuth "Desktop app" client JSON at data/client_secret.json, then run:
#   .venv/bin/python scripts/google_auth.py
# which writes data/google_token.json.
# GOOGLE_CLIENT_SECRET_FILE=data/client_secret.json
# GOOGLE_TOKEN_FILE=data/google_token.json

# --- optional (defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high
# STRICT_TOOLS=true
# REFUSAL_FALLBACK=true
# TIMEZONE=Asia/Singapore
# TIMEZONE_LABEL=SGT
# DEFAULT_DURATION_MIN=60
# DEFAULT_EVENT_TITLE=Tennis lesson
# CALENDAR_ID=primary            # use a test calendar's id first (spec §11 phase 5)
# NEXT_WEEKDAY_POLICY=ask        # ask | upcoming | following_week
# CONFIRM_MODE=always            # always | never (never only auto-commits creates)
# BACKEND=google                 # google | fake
# DATA_DIR=data
# ROSTER_FILE=data/roster.json
# DAILY_MESSAGE_CAP=200
